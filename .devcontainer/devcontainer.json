{
  "name": "WSCD Web",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
        "extensions": [
            "ms-dotnettools.csdevkit",
            "zignd.html-css-class-completion"
        ]
    }
  },
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": {
      "label": "WSCD web",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "dotnet restore web/Wscd.sln && dotnet tool restore --tool-manifest web/.config/dotnet-tools.json && npm ci --prefix web/Wscd.Web && npm run css:build --prefix web/Wscd.Web"
}
