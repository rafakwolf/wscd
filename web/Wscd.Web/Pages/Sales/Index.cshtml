@page "/vendas"
@using System.Globalization
@model Wscd.Web.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Vendas";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
    var current = Model.Current;
    var filters = new Dictionary<string, string?>
    {
        ["Search"] = Model.Search,
        ["From"] = Model.From?.ToString("yyyy-MM-dd"),
        ["To"] = Model.To?.ToString("yyyy-MM-dd"),
        ["Completed"] = Model.Completed?.ToString()
    };
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">Vendas</h1>
            <p class="mt-1 text-sm text-slate-600">Registre vendas de balcão com pagamento integral em dinheiro. Rascunhos não alteram estoque nem caixa.</p>
        </div>
        <a asp-page="./Index" asp-all-route-data="filters" asp-route-create="true" class="rounded bg-slate-900 px-4 py-2 text-white">Nova venda</a>
    </div>
    @if (TempData["StatusMessage"] is string status)
    {
        <p role="status" class="mt-4 rounded bg-green-50 p-3 text-sm text-green-800">@status</p>
    }
    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    <form method="get" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div><label asp-for="Search" class="block text-sm">Cliente</label><input asp-for="Search" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="From" class="block text-sm">De</label><input asp-for="From" type="date" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="To" class="block text-sm">Até</label><input asp-for="To" type="date" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="Completed" class="block text-sm">Situação</label><select asp-for="Completed" class="mt-1 w-full rounded border px-3 py-2"><option value="">Todas</option><option value="false">Rascunho</option><option value="true">Concluída</option></select></div>
        <div class="flex items-end gap-2"><button class="rounded border px-4 py-2">Filtrar</button><a asp-page="./Index" class="px-2 py-2 text-slate-600 underline">Limpar</a></div>
    </form>
    <div class="mt-5 overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead><tr class="border-b text-slate-600"><th scope="col" class="py-2">Número</th><th scope="col">Data</th><th scope="col">Cliente</th><th scope="col">Total</th><th scope="col">Situação</th><th scope="col" class="sr-only">Ação</th></tr></thead>
            <tbody>
            @foreach (var sale in Model.Sales)
            {
                <tr class="border-b last:border-0">
                    <td class="py-2">@sale.Id</td><td>@sale.Date.ToString("dd/MM/yyyy")</td><td>@sale.CustomerName</td><td>@sale.Total.ToString("C", culture)</td>
                    <td>@(sale.IsCompleted ? "Concluída" : "Rascunho")</td>
                    <td class="text-right"><a asp-page="./Index" asp-all-route-data="filters" asp-route-id="@sale.Id" aria-label="Abrir venda nº @sale.Id" class="underline">Abrir</a></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Sales.Count == 0) { <p class="py-6 text-center text-sm text-slate-500">Nenhuma venda encontrada.</p> }
    </div>
</section>

@if (Model.Create || current is not null)
{
    <section class="mt-6 rounded-lg bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold">@(current is null ? "Nova venda" : $"Venda nº {current.Id}")</h2>
        @if (current is null || Model.CanEdit)
        {
            <form method="post" asp-page-handler="Save" asp-all-route-data="filters" asp-route-id="@Model.Id" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <div><label asp-for="Header.CustomerId" class="block text-sm">Cliente</label><select asp-for="Header.CustomerId" required class="mt-1 w-full rounded border px-3 py-2"><option value="">Selecione</option>@foreach (var customer in Model.Customers) { <option value="@customer.Id">@customer.Name</option> }</select></div>
                <div><label asp-for="Header.SellerId" class="block text-sm">Vendedor</label><select asp-for="Header.SellerId" required class="mt-1 w-full rounded border px-3 py-2"><option value="">Selecione</option>@foreach (var seller in Model.Sellers) { <option value="@seller.Id">@seller.Name</option> }</select></div>
                <div><label asp-for="Header.Date" class="block text-sm">Data da venda</label><input asp-for="Header.Date" type="date" required class="mt-1 w-full rounded border px-3 py-2" /></div>
                <div class="sm:col-span-2"><label asp-for="Header.Notes" class="block text-sm">Observações</label><textarea asp-for="Header.Notes" rows="2" class="mt-1 w-full rounded border px-3 py-2"></textarea></div>
                <div class="flex items-end"><button class="rounded bg-slate-900 px-4 py-2 text-white">Salvar rascunho</button></div>
            </form>
        }
        else
        {
            <p class="mt-3 text-sm text-slate-600">@current.Date.ToString("dd/MM/yyyy") · Cliente: @current.Customer.Name · Vendedor: @current.Seller.Name</p>
            @if (current.Notes is not null) { <p class="mt-2 whitespace-pre-wrap text-sm">@current.Notes</p> }
            @if (current.QuotationId is int quoteId)
            {
                <p class="mt-2 text-sm">Origem: <a asp-page="/Quotations/Index" asp-route-id="@quoteId" class="underline">Orçamento nº @quoteId</a>. Os itens e preços acordados foram preservados.</p>
            }
        }

        @if (current is not null)
        {
            <div class="mt-6 overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead><tr class="border-b text-slate-600"><th scope="col" class="py-2">Produto</th><th scope="col">Quantidade</th><th scope="col">Preço unitário</th><th scope="col">Desconto</th><th scope="col">Total</th>@if (Model.CanEdit) { <th scope="col" class="sr-only">Ação</th> }</tr></thead>
                    <tbody>
                    @foreach (var item in current.Items)
                    {
                        <tr class="border-b last:border-0">
                            <td class="py-2">@item.ProductName</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("C", culture)</td><td>@(item.DiscountPercent.ToString("0.##", culture))%</td><td>@item.Total.ToString("C", culture)</td>
                            @if (Model.CanEdit)
                            {
                                <td class="text-right"><form method="post" asp-page-handler="RemoveItem" asp-all-route-data="filters" asp-route-id="@current.Id"><input type="hidden" name="itemId" value="@item.Id" /><button aria-label="Remover @item.ProductName" class="text-red-700 underline">Remover</button></form></td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
                @if (current.Items.Count == 0) { <p class="py-4 text-sm text-slate-500">Nenhum produto adicionado.</p> }
                <p class="mt-3 text-right font-semibold">Total: @current.Total.ToString("C", culture)</p>
            </div>
            @if (Model.CanEdit)
            {
                <form method="post" asp-page-handler="AddItem" asp-all-route-data="filters" asp-route-id="@current.Id" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                    <div class="sm:col-span-2"><label asp-for="Line.ProductId" class="block text-sm">Produto</label><select asp-for="Line.ProductId" required class="mt-1 w-full rounded border px-3 py-2"><option value="">Selecione</option>@foreach (var product in Model.Products) { <option value="@product.Id">@product.Name (estoque: @product.Stock)</option> }</select></div>
                    <div><label asp-for="Line.Quantity" class="block text-sm">Quantidade</label><input asp-for="Line.Quantity" type="number" min="1" required class="mt-1 w-full rounded border px-3 py-2" /></div>
                    <div><label asp-for="Line.DiscountPercent" class="block text-sm">Desconto (%)</label><input asp-for="Line.DiscountPercent" type="number" min="0" max="100" step="0.01" class="mt-1 w-full rounded border px-3 py-2" /></div>
                    <div><button class="rounded border px-4 py-2">Adicionar produto</button></div>
                </form>
            }
            @if (current.Payment is { } payment)
            {
                <p class="mt-5 rounded bg-green-50 p-3 text-sm text-green-800">Concluída. Recebimento em dinheiro de @payment.Amount.ToString("C", culture) registrado em @payment.CashAccount.Name.</p>
            }
            else if (!current.IsCompleted)
            {
                <form method="post" asp-page-handler="Checkout" asp-all-route-data="filters" asp-route-id="@current.Id" class="mt-5 flex flex-wrap items-end gap-3 border-t pt-4">
                    <input type="hidden" name="revision" value="@current.Revision" />
                    <div><label for="cashAccountId" class="block text-sm">Conta caixa do recebimento</label><select id="cashAccountId" name="cashAccountId" required class="mt-1 w-full rounded border px-3 py-2"><option value="">Selecione</option>@foreach (var account in Model.CashAccounts) { <option value="@account.Id">@account.Name</option> }</select></div>
                    <button class="rounded bg-green-700 px-4 py-2 text-white disabled:opacity-50" disabled="@(current.Total <= 0 || Model.CashAccounts.Count == 0)">Concluir e registrar recebimento</button>
                </form>
                @if (Model.CashAccounts.Count == 0)
                {
                    <p class="mt-2 text-sm text-slate-600">Cadastre ou reative uma <a asp-page="/Catalogs/CashAccounts/Index" class="underline">conta caixa</a> para receber.</p>
                }
            }
        }
    </section>
}
