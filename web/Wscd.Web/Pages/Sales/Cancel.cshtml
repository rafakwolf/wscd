@page "/vendas/{id:int}/cancelar"
@using System.Globalization
@using Wscd.Web.Pages
@model Wscd.Web.Pages.Sales.CancelModel
@{
    ViewData["Title"] = $"Cancelar venda nº {Model.Id}";
    var sale = Model.Current!;
    var culture = CultureInfo.GetCultureInfo("pt-BR");
    var refunds = sale.Payments.Concat(sale.Receivable?.Payments ?? []).Where(payment => payment.ReversedAtUtc is null).ToArray();
}

<div class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">@ViewData["Title"]</h1>
    <a asp-page="./Edit" asp-all-route-data="Model.ListFilters" asp-route-id="@Model.Id" class="rounded border px-4 py-2 text-slate-700">Voltar à venda</a>
</div>
<section class="rounded-lg bg-white p-6 shadow-sm">
    <p class="font-semibold">@sale.Customer.Name · Total: @sale.Total.ToString("C", culture)</p>
    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    @if (sale.Returns.Count > 0)
    {
        <p class="mt-3 text-sm text-slate-600">A venda já tem devolução. Se houver itens restantes, use a opção Registrar devolução no detalhe da venda.</p>
    }
    else if (!sale.IsCompleted || sale.IsCancelled)
    {
        <p class="mt-3 text-sm text-slate-600">O cancelamento não está disponível para esta venda.</p>
    }
    else if (!Model.NeedsReview)
    {
        <p class="mt-3 text-sm text-slate-600">O estoque será recomposto e o saldo do crediário, se houver, será cancelado. Confirme apenas depois de receber os produtos de volta e devolver os valores aplicáveis fora do ERP. Esta ação não pode ser desfeita.</p>
        @if (refunds.Length > 0)
        {
            <h2 class="mt-4 font-semibold">Valores a devolver: @refunds.Sum(payment => payment.Amount).ToString("C", culture)</h2>
            <ul class="mt-2 list-disc pl-5 text-sm">
                @foreach (var payment in refunds)
                {
                    <li>@payment.Amount.ToString("C", culture) · @PaymentLabels.For(payment.Method) · @payment.CashAccount.Name</li>
                }
            </ul>
        }
        <form method="post" asp-page="./Cancel" asp-all-route-data="Model.ListFilters" asp-route-id="@Model.Id" class="mt-4 space-y-4">
            <input asp-for="Input.Revision" type="hidden" />
            <input asp-for="ReceivableRevision" type="hidden" />
            <div>
                <label asp-for="Input.Reason" class="block text-sm font-medium">Motivo do cancelamento</label>
                <textarea asp-for="Input.Reason" maxlength="240" rows="3" required class="mt-1 w-full rounded border px-3 py-2"></textarea>
            </div>
            <button class="rounded bg-red-700 px-4 py-2 text-white">Confirmar cancelamento</button>
        </form>
    }
</section>
