@page "/relatorios/produtos-por-grupo"
@using System.Globalization
@model Wscd.Web.Pages.Reports.ProductsByGroup.IndexModel
@{
    ViewData["Title"] = "Produtos por grupo";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Produtos por grupo</h1>
        <div class="flex flex-wrap gap-2 print:hidden">
            <a asp-page="/Catalogs/Products/Index" class="rounded border px-4 py-2">Ir para Produtos</a>
            @if (Model.Products is { Count: > 0 })
            {
                <button type="button" onclick="window.print()" class="rounded border px-4 py-2">Imprimir / Salvar PDF</button>
            }
        </div>
    </div>

    @if (Model.Groups.Count > 0)
    {
        <form method="get" class="mt-5 flex flex-wrap items-end gap-3 print:hidden">
            <div>
                <label asp-for="GroupId" class="block text-sm">Grupo</label>
                <select asp-for="GroupId" required class="mt-1 w-full rounded border px-3 py-2">
                    <option value="">Selecione um grupo</option>
                    @foreach (var group in Model.Groups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="rounded bg-slate-900 px-4 py-2 text-white">Gerar relatório</button>
        </form>
    }

    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    else if (Model.Groups.Count == 0)
    {
        <p class="py-6 text-center text-sm text-slate-500">Nenhum grupo de produtos cadastrado.</p>
    }
    else if (Model.Products is { Count: 0 })
    {
        <p class="py-6 text-center text-sm text-slate-500">Nenhum produto cadastrado neste grupo.</p>
    }
    else if (Model.Products is { } products)
    {
        <p class="mt-6 text-sm text-slate-600">@Model.GroupName · Emitido em @Model.ReportDate.ToString("dd/MM/yyyy", culture) (Brasília)</p>
        <div class="mt-3 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b text-slate-600">
                        <th scope="col" class="py-2 pr-4">Código de barras</th>
                        <th scope="col" class="pr-4">Produto</th>
                        <th scope="col" class="pr-4">Fornecedor</th>
                        <th scope="col" class="pr-4 text-right">Custo</th>
                        <th scope="col" class="pr-4 text-right">Margem (%)</th>
                        <th scope="col" class="pr-4 text-right">Preço de venda</th>
                        <th scope="col" class="text-right">Estoque</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var product in products)
                {
                    <tr class="border-b last:border-0">
                        <td class="py-2 pr-4">@(product.Barcode ?? "—")</td>
                        <td class="pr-4">@product.Name</td>
                        <td class="pr-4">@(product.SupplierName ?? "—")</td>
                        <td class="pr-4 text-right">@product.Cost.ToString("C", culture)</td>
                        <td class="pr-4 text-right">@product.MarginPercent.ToString("N2", culture)</td>
                        <td class="pr-4 text-right">@product.SalePrice.ToString("C", culture)</td>
                        <td class="text-right">@product.Stock.ToString(culture)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
