@page "/relatorios/lista-de-precos"
@using System.Globalization
@model Wscd.Web.Pages.Reports.PriceList.IndexModel
@{
    ViewData["Title"] = "Lista de preços";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Lista de preços</h1>
        <div class="flex flex-wrap gap-2 print:hidden">
            <a asp-page="/Catalogs/Products/Index" class="rounded border px-4 py-2">Ir para Produtos</a>
            @if (Model.Products.Count > 0)
            {
                <button type="button" onclick="window.print()" class="rounded border px-4 py-2">Imprimir / Salvar PDF</button>
            }
        </div>
    </div>

    <form method="get" class="mt-5 flex flex-wrap items-end gap-3 print:hidden">
        <div>
            <label asp-for="ByPrice" class="block text-sm">Ordenar por</label>
            <select asp-for="ByPrice" class="mt-1 w-full rounded border px-3 py-2">
                <option value="false">Descrição do produto</option>
                <option value="true">Preço de venda</option>
            </select>
        </div>
        <button type="submit" class="rounded bg-slate-900 px-4 py-2 text-white">Aplicar</button>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">Selecione uma ordenação válida.</p>
    }
    else if (Model.Products.Count == 0)
    {
        <p class="py-6 text-center text-sm text-slate-500">Nenhum produto cadastrado.</p>
    }
    else
    {
        <p class="mt-6 text-sm text-slate-600">Emitido em @Model.ReportDate.ToString("dd/MM/yyyy", culture) (Brasília)</p>
        <div class="mt-3 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b text-slate-600">
                        <th scope="col" class="py-2 pr-4">Descrição do produto</th>
                        <th scope="col" class="text-right">Preço de venda</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr class="border-b last:border-0">
                        <td class="py-2 pr-4">@product.Name</td>
                        <td class="text-right">@product.SalePrice.ToString("C", culture)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
