@page "/relatorios/estoque"
@using System.Globalization
@using Wscd.Services.Reports
@model Wscd.Web.Pages.Reports.StockPosition.IndexModel
@{
    ViewData["Title"] = "Posição de estoque";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
    const string atOrBelowMinimum = "No mínimo ou abaixo";
    const string outOfStock = "Sem estoque";
    var statusLabel = Model.Status switch
    {
        StockPositionFilter.AtOrBelowMinimum => atOrBelowMinimum,
        StockPositionFilter.OutOfStock => outOfStock,
        _ => "Todas"
    };
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">Posição de estoque</h1>
            <p class="mt-1 text-sm text-slate-600">Quantidade atual por produto e comparação com o estoque mínimo cadastrado.</p>
        </div>
        <div class="flex flex-wrap gap-2 print:hidden">
            <a asp-page="/Catalogs/Products/Index" class="rounded border px-4 py-2">Ir para Produtos</a>
            @if (Model.Report is { Products.Count: > 0 })
            {
                <button type="button" onclick="window.print()" class="rounded border px-4 py-2">Imprimir / Salvar PDF</button>
            }
        </div>
    </div>

    <form method="get" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 print:hidden">
        <div><label asp-for="Search" class="block text-sm">Nome ou código de barras</label><input asp-for="Search" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div>
            <label asp-for="GroupId" class="block text-sm">Grupo</label>
            <select asp-for="GroupId" class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Todos</option>
                @foreach (var group in Model.Groups) { <option value="@group.Id">@group.Name</option> }
            </select>
        </div>
        <div>
            <label asp-for="SupplierId" class="block text-sm">Fornecedor</label>
            <select asp-for="SupplierId" class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Todos</option>
                @foreach (var supplier in Model.Suppliers) { <option value="@supplier.Id">@supplier.Name</option> }
            </select>
        </div>
        <div>
            <label asp-for="Status" class="block text-sm">Situação</label>
            <select asp-for="Status" class="mt-1 w-full rounded border px-3 py-2">
                <option value="@nameof(StockPositionFilter.All)">Todas</option>
                <option value="@nameof(StockPositionFilter.AtOrBelowMinimum)">@atOrBelowMinimum</option>
                <option value="@nameof(StockPositionFilter.OutOfStock)">@outOfStock</option>
            </select>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:col-span-2">
            <button class="rounded bg-slate-900 px-4 py-2 text-white">Gerar relatório</button>
            <a asp-page="./Index" class="px-2 py-2 text-slate-600 underline">Limpar filtros</a>
        </div>
    </form>

    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    else if (Model.Report is { } report)
    {
        <div class="mt-6">
            <p class="mb-3 text-sm text-slate-600">
                Posição em @Model.ReportDate.ToString("dd/MM/yyyy", culture) (Brasília) · Busca: @(string.IsNullOrEmpty(Model.Search) ? "todas" : Model.Search)
                · Grupo: @(Model.GroupName ?? "todos") · Fornecedor: @(Model.SupplierName ?? "todos") · Situação: @statusLabel
            </p>
            <dl class="grid gap-3 border-y py-3 text-sm sm:grid-cols-3">
                <div><dt>Produtos listados</dt><dd class="font-semibold">@report.Products.Count</dd></div>
                <div><dt>@atOrBelowMinimum</dt><dd class="font-semibold">@report.AtOrBelowMinimumCount</dd></div>
                <div><dt>@outOfStock</dt><dd class="font-semibold">@report.OutOfStockCount</dd></div>
            </dl>
            @if (report.Products.Count == 0)
            {
                <p class="py-6 text-center text-sm text-slate-500">Nenhum produto encontrado para os filtros informados.</p>
            }
            else
            {
                <div class="mt-3 overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead><tr class="border-b text-slate-600">
                            <th scope="col" class="py-2">Produto</th><th scope="col">Grupo</th><th scope="col">Fornecedor</th>
                            <th scope="col">Unidade</th><th scope="col" class="text-right">Estoque atual</th>
                            <th scope="col" class="text-right">Estoque mínimo</th><th scope="col">Situação</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var product in report.Products)
                        {
                            <tr class="border-b last:border-0">
                                <td class="py-2">
                                    <a asp-page="/Catalogs/Products/Edit" asp-route-id="@product.Id" class="underline">@product.Name</a>
                                    @if (product.Barcode is not null) { <span class="block text-xs text-slate-600">@product.Barcode</span> }
                                </td>
                                <td>@(product.GroupName ?? "Não informado")</td><td>@(product.SupplierName ?? "Não informado")</td>
                                <td>@(product.UnitName ?? "Não informada")</td>
                                <td class="text-right">@product.Stock</td><td class="text-right">@product.MinimumStock</td>
                                <td>@(product.OutOfStock ? outOfStock : product.AtOrBelowMinimum ? atOrBelowMinimum : "Acima do mínimo")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</section>
