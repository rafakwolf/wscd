@page "/relatorios/vendas"
@using System.Globalization
@model Wscd.Web.Pages.Reports.Sales.IndexModel
@{
    ViewData["Title"] = "Vendas por período";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">Vendas por período</h1>
            <p class="mt-1 text-sm text-slate-600">Vendas concluídas pela data da venda, sem cancelamentos. As devoluções reduzem o total da venda original, mesmo quando registradas depois do período.</p>
        </div>
        @if (Model.Report is { Rows.Count: > 0 })
        {
            <button type="button" onclick="window.print()" class="rounded border px-4 py-2 print:hidden">Imprimir / Salvar PDF</button>
        }
    </div>

    <form method="get" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 print:hidden">
        <div><label asp-for="From" class="block text-sm">Data inicial</label><input asp-for="From" type="date" required class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="To" class="block text-sm">Data final</label><input asp-for="To" type="date" required class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="Customer" class="block text-sm">Nome do cliente</label><input asp-for="Customer" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div>
            <label asp-for="SellerId" class="block text-sm">Vendedor</label>
            <select asp-for="SellerId" class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Todos</option>
                @foreach (var seller in Model.Sellers)
                {
                    <option value="@seller.Id">@seller.Name@(seller.IsActive ? "" : " (inativo)")</option>
                }
            </select>
        </div>
        <div class="flex items-center gap-2 sm:col-span-2">
            <button class="rounded bg-slate-900 px-4 py-2 text-white">Gerar relatório</button>
            <a asp-page="./Index" class="px-2 py-2 text-slate-600 underline">Mês atual</a>
        </div>
    </form>

    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    else if (Model.Report is { } report)
    {
        <div class="mt-6">
            <p class="mb-3 text-sm text-slate-600">
                Período: @Model.From?.ToString("dd/MM/yyyy", culture) a @Model.To?.ToString("dd/MM/yyyy", culture)
                · Cliente: @(string.IsNullOrEmpty(Model.Customer) ? "todos" : Model.Customer) · Vendedor: @(Model.SellerName ?? "todos")
            </p>
            @if (report.Rows.Count == 0)
            {
                <p class="py-6 text-center text-sm text-slate-500">Nenhuma venda concluída encontrada para os filtros informados.</p>
            }
            else
            {
                <p class="mb-2 text-sm text-slate-600">Vendas listadas: @report.Rows.Count. Os valores de venda não representam recebimentos no Caixa.</p>
                <dl class="grid gap-3 border-y py-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
                    <div><dt>Descontos originais</dt><dd class="font-semibold">@report.ItemDiscounts.ToString("C", culture)</dd></div>
                    <div><dt>Total após descontos</dt><dd class="font-semibold">@report.OriginalTotal.ToString("C", culture)</dd></div>
                    <div><dt>Devoluções</dt><dd class="font-semibold">@report.ReturnedAmount.ToString("C", culture)</dd></div>
                    <div><dt>Total líquido</dt><dd class="font-semibold">@report.NetTotal.ToString("C", culture)</dd></div>
                </dl>
                <div class="mt-3 overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="border-b text-slate-600">
                                <th scope="col" class="py-2">Venda</th><th scope="col">Data</th><th scope="col">Cliente</th><th scope="col">Vendedor</th>
                                <th scope="col" class="text-right">Desconto</th><th scope="col" class="text-right">Total após descontos</th>
                                <th scope="col" class="text-right">Devolvido</th><th scope="col" class="text-right">Líquido</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var sale in report.Rows)
                        {
                            <tr class="border-b last:border-0">
                                <td class="py-2"><a asp-page="/Sales/Edit" asp-route-id="@sale.SaleId" aria-label="Consultar venda nº @sale.SaleId" class="underline">#@sale.SaleId</a></td>
                                <td>@sale.Date.ToString("dd/MM/yyyy", culture)</td><td>@sale.CustomerName</td><td>@sale.SellerName</td>
                                <td class="text-right">@sale.ItemDiscounts.ToString("C", culture)</td><td class="text-right">@sale.OriginalTotal.ToString("C", culture)</td>
                                <td class="text-right">@sale.ReturnedAmount.ToString("C", culture)</td><td class="text-right">@sale.NetTotal.ToString("C", culture)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</section>
