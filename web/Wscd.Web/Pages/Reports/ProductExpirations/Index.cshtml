@page "/relatorios/validade-produtos"
@using System.Globalization
@model Wscd.Web.Pages.Reports.ProductExpirations.IndexModel
@{
    ViewData["Title"] = "Validade de produtos";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Validade de produtos</h1>
        <div class="flex flex-wrap gap-2 print:hidden">
            <a asp-page="/Catalogs/Products/Index" class="rounded border px-4 py-2">Ir para Produtos</a>
            @if (Model.Report is { Products.Count: > 0 })
            {
                <button type="button" onclick="window.print()" class="rounded border px-4 py-2">Imprimir / Salvar PDF</button>
            }
        </div>
    </div>

    <form method="get" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 print:hidden">
        <div>
            <label asp-for="Through" class="block text-sm">Validade até</label>
            <input asp-for="Through" type="date" required class="mt-1 w-full rounded border px-3 py-2" />
        </div>
        <div>
            <label asp-for="UnitId" class="block text-sm">Unidade de venda</label>
            <select asp-for="UnitId" class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Todas</option>
                @foreach (var unit in Model.Units) { <option value="@unit.Id">@unit.Name</option> }
            </select>
        </div>
        <div>
            <label asp-for="GroupId" class="block text-sm">Grupo</label>
            <select asp-for="GroupId" class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Todos</option>
                @foreach (var group in Model.Groups) { <option value="@group.Id">@group.Name</option> }
            </select>
        </div>
        <div>
            <label asp-for="SupplierId" class="block text-sm">Fornecedor</label>
            <select asp-for="SupplierId" class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Todos</option>
                @foreach (var supplier in Model.Suppliers) { <option value="@supplier.Id">@supplier.Name</option> }
            </select>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:col-span-2">
            <button type="submit" class="rounded bg-slate-900 px-4 py-2 text-white">Gerar relatório</button>
            <a asp-page="./Index" class="px-2 py-2 text-slate-600 underline">Limpar filtros</a>
        </div>
    </form>

    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    else if (Model.Report is { Products.Count: 0 })
    {
        <p class="py-6 text-center text-sm text-slate-500">Nenhum produto com validade até a data informada para esses filtros.</p>
    }
    else if (Model.Report is { } report)
    {
        <p class="mt-6 text-sm text-slate-600">
            Validade até @Model.Through?.ToString("dd/MM/yyyy", culture) · Unidade: @(Model.UnitName ?? "todas")
            · Grupo: @(Model.GroupName ?? "todos") · Fornecedor: @(Model.SupplierName ?? "todos")
        </p>
        <div class="mt-3 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b text-slate-600">
                        <th scope="col" class="py-2 pr-4">Código de barras</th>
                        <th scope="col" class="pr-4">Produto</th>
                        <th scope="col" class="pr-4">Validade</th>
                        <th scope="col" class="pr-4">Fornecedor</th>
                        <th scope="col" class="text-right">Custo unitário</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var product in report.Products)
                {
                    <tr class="border-b">
                        <td class="py-2 pr-4">@(product.Barcode ?? "—")</td>
                        <td class="pr-4">@product.Name</td>
                        <td class="pr-4">@product.ExpirationDate.ToString("dd/MM/yyyy", culture)</td>
                        <td class="pr-4">@(product.SupplierName ?? "—")</td>
                        <td class="text-right">@product.UnitCost.ToString("C", culture)</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr class="font-semibold">
                        <th scope="row" colspan="4" class="py-2 pr-4">Soma dos custos unitários</th>
                        <td class="text-right">@report.TotalUnitCost.ToString("C", culture)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</section>
