@page "/relatorios/baixas/{kind}"
@using System.Globalization
@using Wscd.Web.Pages
@model Wscd.Web.Pages.Reports.TitleSettlements.IndexModel
@{
    ViewData["Title"] = Model.IsPayable ? "Baixas de contas a pagar" : "Baixas de contas a receber";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
    var partyLabel = Model.IsPayable ? "Fornecedor" : "Cliente";
    var movementLabel = Model.IsPayable ? "Pagamento" : "Recebimento";
    var listPage = Model.IsPayable ? "/Payables/Index" : "/Receivables/Index";
    var detailsPage = Model.IsPayable ? "/Payables/Details" : "/Receivables/Details";
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">@ViewData["Title"]</h1>
            <p class="mt-1 text-sm text-slate-600">Baixas parciais ou integrais de títulos. Cada estorno entra na data em que foi registrado, mesmo que a baixa original esteja fora do período.</p>
        </div>
        <div class="flex flex-wrap gap-2 print:hidden">
            <a asp-page="@listPage" class="rounded border px-4 py-2">Voltar às contas</a>
            @if (Model.Report is { Movements.Count: > 0 })
            {
                <button type="button" onclick="window.print()" class="rounded border px-4 py-2">Imprimir / Salvar PDF</button>
            }
        </div>
    </div>

    <form method="get" asp-page="./Index" asp-route-kind="@Model.Kind" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 print:hidden">
        <div><label asp-for="Party" class="block text-sm">@partyLabel</label><input asp-for="Party" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div>
            <label asp-for="CashAccountId" class="block text-sm">Conta caixa</label>
            <select asp-for="CashAccountId" class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Todas</option>
                @foreach (var account in Model.CashAccounts)
                {
                    <option value="@account.Id">@account.Name@(account.IsInactive ? " (inativa)" : null)</option>
                }
            </select>
        </div>
        <div><label asp-for="From" class="block text-sm">Data inicial</label><input asp-for="From" type="date" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="To" class="block text-sm">Data final</label><input asp-for="To" type="date" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div class="flex flex-wrap items-center gap-2 sm:col-span-2">
            <button class="rounded bg-slate-900 px-4 py-2 text-white">Gerar relatório</button>
            <a asp-page="./Index" asp-route-kind="@Model.Kind" class="px-2 py-2 text-slate-600 underline">Mês atual</a>
        </div>
    </form>

    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    else if (Model.Report is { } report)
    {
        <div class="mt-6">
            <p class="mb-3 text-sm text-slate-600">
                De @(Model.From?.ToString("dd/MM/yyyy", culture) ?? "sem limite inicial") até @(Model.To?.ToString("dd/MM/yyyy", culture) ?? "sem limite final") (Brasília).
                @partyLabel: @(string.IsNullOrEmpty(Model.Party) ? "todos" : Model.Party) · Conta caixa: @(Model.AccountName ?? "todas")
            </p>
            <dl class="grid gap-3 border-y py-3 text-sm sm:grid-cols-3">
                <div><dt>@(Model.IsPayable ? "Total pago" : "Total recebido")</dt><dd class="font-semibold">@report.Gross.ToString("C", culture)</dd></div>
                <div><dt>Estornos</dt><dd class="font-semibold">@report.Reversals.ToString("C", culture)</dd></div>
                <div><dt>Total líquido</dt><dd class="font-semibold">@report.Net.ToString("C", culture)</dd></div>
            </dl>
            @if (report.Movements.Count == 0)
            {
                <p class="py-6 text-center text-sm text-slate-500">Nenhuma baixa ou estorno encontrado para os filtros informados.</p>
            }
            else
            {
                <div class="mt-3 overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead><tr class="border-b text-slate-600">
                            <th scope="col" class="py-2">Data e hora</th><th scope="col">Tipo</th><th scope="col">Título</th><th scope="col">@partyLabel</th>
                            <th scope="col">Conta caixa</th><th scope="col">Meio</th><th scope="col" class="text-right">Valor</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var movement in report.Movements)
                        {
                            var id = Model.IsPayable ? movement.AccountPayableId : movement.AccountReceivableId;
                            var type = movement.IsSaleCancellation ? "Estorno por cancelamento da venda" : movement.IsReversal ? "Estorno de baixa" : movementLabel;
                            var signedAmount = movement.IsReversal ? -movement.Amount : movement.Amount;
                            <tr class="border-b last:border-0">
                                <td class="py-2">@movement.OccurredAt.ToString("dd/MM/yyyy HH:mm", culture)</td>
                                <td>@type</td>
                                <td><a asp-page="@detailsPage" asp-route-id="@id" aria-label="Consultar título nº @id" class="underline">#@id</a></td>
                                <td>@movement.PartyName</td><td>@movement.CashAccountName</td><td>@PaymentLabels.For(movement.Method)</td>
                                <td class="text-right">@signedAmount.ToString("C", culture)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</section>
