@page "/relatorios/comissao-vendedores"
@using System.Globalization
@model Wscd.Web.Pages.Reports.SellerCommissions.IndexModel
@{
    ViewData["Title"] = "Comissão por vendedor";
    var culture = CultureInfo.GetCultureInfo("pt-BR");
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">Comissão por vendedor</h1>
            <p class="mt-1 text-sm text-slate-600">Vendas concluídas por data da venda. Cancelamentos são excluídos e devoluções registradas reduzem a base.</p>
        </div>
        @if (Model.Report is { Rows.Count: > 0 })
        {
            <button type="button" onclick="window.print()" class="rounded border px-4 py-2 print:hidden">Imprimir / Salvar PDF</button>
        }
    </div>

    <form method="get" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4 print:hidden">
        <div>
            <label asp-for="SellerId" class="block text-sm">Vendedor</label>
            <select asp-for="SellerId" required class="mt-1 w-full rounded border px-3 py-2">
                <option value="">Selecione</option>
                @foreach (var seller in Model.Sellers)
                {
                    <option value="@seller.Id">@seller.Name@(seller.IsActive ? "" : " (inativo)")</option>
                }
            </select>
        </div>
        <div><label asp-for="From" class="block text-sm">Data inicial</label><input asp-for="From" type="date" required class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="To" class="block text-sm">Data final</label><input asp-for="To" type="date" required class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div class="flex items-end"><button class="rounded bg-slate-900 px-4 py-2 text-white">Gerar relatório</button></div>
    </form>

    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }
    else if (Model.Report is { } report)
    {
        <div class="mt-6">
            <p class="mb-3 text-sm text-slate-600">Vendedor: @report.SellerName · Período: @report.From.ToString("dd/MM/yyyy", culture) a @report.To.ToString("dd/MM/yyyy", culture)</p>
            @if (report.Rows.Count == 0)
            {
                <p class="py-6 text-center text-sm text-slate-500">Nenhuma venda líquida encontrada para os filtros informados.</p>
            }
            else
            {
                <div class="flex flex-wrap justify-between gap-2 border-b pb-3">
                    <p class="font-semibold">Total líquido: @report.NetSales.ToString("C", culture)</p>
                    <p class="font-semibold">Comissão total: @report.Commission.ToString("C", culture)</p>
                </div>
                <div class="mt-3 overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead><tr class="border-b text-slate-600"><th scope="col" class="py-2">Produto</th><th scope="col" class="text-right">Qtde. líquida</th><th scope="col" class="text-right">Venda líquida</th><th scope="col" class="text-right">Comissão</th></tr></thead>
                        <tbody>
                        @foreach (var row in report.Rows)
                        {
                            <tr class="border-b last:border-0"><td class="py-2">@row.ProductName</td><td class="text-right">@row.Quantity</td><td class="text-right">@row.NetSales.ToString("C", culture)</td><td class="text-right">@row.Commission.ToString("C", culture)</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</section>
