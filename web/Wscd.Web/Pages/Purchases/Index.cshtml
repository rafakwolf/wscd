@page
@using System.Globalization
@model Wscd.Web.Pages.Purchases.IndexModel
@{
    ViewData["Title"] = "Compras";
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">Compras</h1>
            <p class="mt-1 text-sm text-slate-600">Rascunhos não alteram estoque nem financeiro. Concluir registra a entrada e cria uma conta a pagar.</p>
        </div>
        <a asp-page="./Edit" asp-all-route-data="Model.ListFilters" class="rounded bg-slate-900 px-4 py-2 text-white">Nova compra</a>
    </div>

    @if (TempData["StatusMessage"] is string status)
    {
        <p class="mt-4 rounded bg-green-50 p-3 text-sm text-green-800">@status</p>
    }

    @if (Model.Error is not null)
    {
        <p role="alert" class="mt-4 rounded bg-red-50 p-3 text-sm text-red-700">@Model.Error</p>
    }

    <form method="get" class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div><label asp-for="Search" class="block text-sm">Fornecedor</label><input asp-for="Search" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="From" class="block text-sm">De</label><input asp-for="From" type="date" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="To" class="block text-sm">Até</label><input asp-for="To" type="date" class="mt-1 w-full rounded border px-3 py-2" /></div>
        <div><label asp-for="Completed" class="block text-sm">Situação</label><select asp-for="Completed" class="mt-1 w-full rounded border px-3 py-2"><option value="">Todas</option><option value="false">Rascunho</option><option value="true">Concluída</option></select></div>
        <div class="flex items-end gap-2"><button class="rounded border px-4 py-2">Filtrar</button><a asp-page="./Index" class="px-2 py-2 text-slate-600 underline">Limpar</a></div>
    </form>

    <div class="mt-5 overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead><tr class="border-b text-slate-600"><th class="py-2">Número</th><th>Data</th><th>Fornecedor</th><th>Total</th><th>Situação</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="border-b last:border-0">
                    <td class="py-2">@item.Id</td><td>@item.PurchaseDate.ToString("dd/MM/yyyy")</td><td>@item.SupplierName</td><td>R$ @item.Total.ToString("N2", CultureInfo.GetCultureInfo("pt-BR"))</td>
                    <td>@(item.IsCompleted ? "Concluída" : "Rascunho")</td>
                    <td class="text-right"><a asp-page="./Edit" asp-all-route-data="Model.ListFilters" asp-route-id="@item.Id" class="text-slate-900 underline">@(item.IsCompleted ? "Consultar" : "Editar")</a></td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Items.Count == 0) { <p class="py-6 text-center text-sm text-slate-500">Nenhuma compra encontrada.</p> }
    </div>
</section>
