<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WSCD</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
            <a class="text-xl font-semibold" asp-area="" asp-page="/Index">WSCD</a>
            <a class="rounded px-3 py-2 text-sm text-slate-700 hover:bg-slate-100" asp-area="" asp-page="/Index">Início</a>
        </nav>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-8">
        @RenderBody()
    </main>
    <footer class="mt-12 border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-4 text-sm text-slate-500">
            &copy; 2026 - WSCD
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
