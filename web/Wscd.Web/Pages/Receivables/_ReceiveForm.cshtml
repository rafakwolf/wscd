@using System.Globalization
@using Wscd.Domain.Sales
@using Wscd.Web.Pages
@model Wscd.Web.Pages.Receivables.DetailsModel
@{
    var balance = Model.Account!.Balance.ToString(CultureInfo.InvariantCulture);
}

<section class="mt-6 border-t pt-4" aria-labelledby="receive-title">
    <h2 id="receive-title" class="text-lg font-semibold">Registrar recebimento</h2>
    @if (Model.CashAccounts.Count == 0)
    {
        <p class="mt-2 text-sm text-slate-600">Cadastre ou reative uma <a asp-page="/Catalogs/CashAccounts/Index" class="underline">conta caixa</a> para receber.</p>
    }
    else
    {
        <form method="post" asp-page="./Details" asp-page-handler="Receive" asp-all-route-data="Model.ListFilters" asp-route-id="@Model.Id" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <input type="hidden" name="expectedBalance" value="@balance" />
            <input type="hidden" name="__Invariant" value="expectedBalance" />
            <div>
                <label asp-for="Payment.Method" class="block text-sm">Meio de recebimento</label>
                <select asp-for="Payment.Method" required class="mt-1 w-full rounded border px-3 py-2">
                    <option value="">Selecione</option>
                    @foreach (var method in Enum.GetValues<PaymentMethod>()) { <option value="@((int)method)">@PaymentLabels.For(method)</option> }
                </select>
            </div>
            <div>
                <label asp-for="Payment.CashAccountId" class="block text-sm">Conta caixa</label>
                <select asp-for="Payment.CashAccountId" required class="mt-1 w-full rounded border px-3 py-2">
                    <option value="">Selecione</option>
                    @foreach (var account in Model.CashAccounts) { <option value="@account.Id">@account.Name</option> }
                </select>
            </div>
            <div><label asp-for="Payment.Amount" class="block text-sm">Valor recebido (R$)</label><input asp-for="Payment.Amount" type="number" inputmode="decimal" min="0.01" max="@balance" step="0.01" required class="mt-1 w-full rounded border px-3 py-2" /></div>
            <div class="flex items-end"><button class="rounded bg-green-700 px-4 py-2 text-white">Registrar recebimento</button></div>
        </form>
    }
</section>
