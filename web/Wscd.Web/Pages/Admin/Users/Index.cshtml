@page
@model Wscd.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Usuários";
}

<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Usuários</h1>
        <a asp-page="./Create" asp-route-search="@Model.Search" class="rounded bg-slate-900 px-4 py-2 text-white">Novo usuário</a>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <p class="rounded border border-green-200 bg-green-50 px-4 py-3 text-green-800">@statusMessage</p>
    }

    <section class="rounded-lg bg-white p-6 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-700"></div>
        <form method="get" class="flex flex-wrap gap-2">
            <label asp-for="Search" class="sr-only">E-mail</label>
            <input asp-for="Search" placeholder="Filtrar por e-mail" class="w-full max-w-lg rounded border px-3 py-2" />
            <button class="rounded border px-4 py-2">Filtrar</button>
            <a asp-page="./Index" class="px-2 py-2 text-slate-600 underline">Limpar</a>
        </form>
        <div class="mt-4 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-slate-200 text-slate-600">
                    <tr><th class="py-2 pr-4">E-mail</th><th class="py-2 pr-4">Situação</th><th class="py-2">Ações</th></tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr class="border-b border-slate-100">
                            <td class="py-3 pr-4">@user.Email</td>
                            <td class="py-3 pr-4">@(user.IsOwner ? "Administrador" : user.IsActive ? "Ativo" : "Removido")</td>
                            <td class="py-3">
                                @if (!user.IsOwner && user.IsActive)
                                {
                                    <form method="post" asp-page-handler="Remove" asp-route-search="@Model.Search">
                                        <input type="hidden" name="memberId" value="@user.UserId" />
                                        <button type="submit" class="text-red-700 underline">Remover acesso</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Users.Count == 0)
                    {
                        <tr><td colspan="3" class="py-6 text-center text-slate-500">Nenhum usuário encontrado.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
