@page
@model Wscd.Web.Pages.Development.DemoDataModel
@{
    ViewData["Title"] = "Dados de demonstração";
}

<section class="mx-auto max-w-2xl rounded-lg bg-white p-6 shadow-sm">
    <h1 class="text-2xl font-semibold">Dados de demonstração</h1>
    <p class="mt-2 text-sm text-slate-600">Garante 10 cadastros fictícios por módulo na organização da sua sessão. Também cria 10 compras (5 rascunhos e 5 concluídas), 10 perdas e 10 promoções. As compras concluídas geram contas a pagar.</p>
    <p class="mt-2 text-sm text-slate-600">A carga pode ser repetida; não apaga nem altera os demais registros. Vendas ainda não estão implementadas.</p>

    @if (Model.StatusMessage is not null)
    {
        <p class="mt-4 rounded bg-green-50 p-3 text-sm text-green-800">@Model.StatusMessage</p>
    }
    <div asp-validation-summary="All" class="mt-4 text-sm text-red-700"></div>

    <form method="post" asp-page-handler="Seed" class="mt-5">
        <button class="rounded bg-slate-900 px-4 py-2 text-white">Criar dados fictícios</button>
    </form>
</section>
