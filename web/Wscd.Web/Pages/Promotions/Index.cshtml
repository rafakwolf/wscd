@page
@using System.Globalization
@model Wscd.Web.Pages.Promotions.IndexModel
@{
    ViewData["Title"] = "Promoções";
    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
}

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-semibold">Promoções</h1>
            <p class="mt-1 text-sm text-slate-600">O preço promocional é calculado a partir do desconto e aplicado ao produto.</p>
        </div>
        <a asp-page="./Index" asp-route-create="true" class="rounded bg-slate-900 px-4 py-2 text-white">Nova promoção</a>
    </div>

    @if (Model.StatusMessage is not null)
    {
        <p class="mt-4 rounded bg-green-50 p-3 text-sm text-green-800">@Model.StatusMessage</p>
    }
    @if (ViewData["ErrorMessage"] is string errorMessage)
    {
        <p class="mt-4 rounded bg-red-50 p-3 text-sm text-red-800">@errorMessage</p>
    }

    <div class="mt-5 overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead><tr class="border-b text-slate-600"><th class="py-2">Produto</th><th>Preço normal</th><th>Desconto</th><th>Preço promocional</th><th>Início</th><th>Fim</th><th>Situação</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="border-b last:border-0">
                    <td class="py-2">@item.ProductName</td>
                    <td>R$ @item.RegularPrice.ToString("N2", ptBr)</td>
                    <td>@item.DiscountPercent.ToString("N2", ptBr)%</td>
                    <td>R$ @item.PromotionPrice.ToString("N2", ptBr)</td>
                    <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                    <td>@IndexModel.StatusLabel(item.StartDate, item.EndDate)</td>
                    <td class="text-right">
                        <a asp-page="./Index" asp-route-id="@item.Id" class="underline">Editar</a>
                        <form method="post" asp-page-handler="Delete" asp-route-promotionId="@item.Id" class="inline">
                            <button class="ml-2 text-red-700 underline">Remover</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        @if (Model.Items.Count == 0) { <p class="py-6 text-center text-sm text-slate-500">Nenhuma promoção cadastrada.</p> }
    </div>
</section>

@if (Model.Create || Model.Current is not null)
{
    <section class="mt-6 rounded-lg bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold">@(Model.Current is null ? "Nova promoção" : $"Editar promoção de {Model.Current.Product.Name}")</h2>
        <div asp-validation-summary="ModelOnly" class="mt-3 text-sm text-red-700"></div>
        <form method="post" asp-page-handler="Save" asp-route-id="@Model.Id" asp-route-create="@Model.Create" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="sm:col-span-2"><label asp-for="Input.ProductId" class="block text-sm">Produto</label><select asp-for="Input.ProductId" class="mt-1 w-full rounded border px-3 py-2" disabled="@(Model.Id is not null ? "disabled" : null)" required><option value="">Selecione</option>@foreach (var product in Model.Products) { <option value="@product.Id">@product.Name — R$ @product.SalePrice.ToString("N2", ptBr)</option> }</select>@if (Model.Id is not null) { <input asp-for="Input.ProductId" type="hidden" /> }</div>
            <div><label asp-for="Input.DiscountPercent" class="block text-sm">Desconto (%)</label><input asp-for="Input.DiscountPercent" type="number" min="0.01" max="99.99" step="0.01" class="mt-1 w-full rounded border px-3 py-2" required /></div>
            <div><label asp-for="Input.StartDate" class="block text-sm">Início</label><input asp-for="Input.StartDate" type="date" class="mt-1 w-full rounded border px-3 py-2" required /></div>
            <div><label asp-for="Input.EndDate" class="block text-sm">Fim</label><input asp-for="Input.EndDate" type="date" class="mt-1 w-full rounded border px-3 py-2" required /></div>
            <div class="sm:col-span-2 lg:col-span-4"><button class="rounded bg-slate-900 px-4 py-2 text-white">Salvar promoção</button></div>
        </form>
    </section>
}
