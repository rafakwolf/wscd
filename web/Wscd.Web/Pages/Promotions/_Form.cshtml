@using System.Globalization
@model Wscd.Web.Pages.Promotions.EditModel
@{ var ptBr = CultureInfo.GetCultureInfo("pt-BR"); }

<section class="rounded-lg bg-white p-6 shadow-sm">
    <div asp-validation-summary="All" class="mt-3 text-sm text-red-700"></div>
    <form method="post" asp-page="./Edit" asp-page-handler="Save" asp-route-search="@Model.Search" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="sm:col-span-2"><label asp-for="Input.ProductId" class="block text-sm">Produto</label><select asp-for="Input.ProductId" class="mt-1 w-full rounded border px-3 py-2" disabled="@(Model.Id is not null ? "disabled" : null)" required><option value="">Selecione</option>@foreach (var product in Model.Products) { <option value="@product.Id">@product.Name — R$ @product.SalePrice.ToString("N2", ptBr)</option> }</select>@if (Model.Id is not null) { <input name="Input.ProductId" value="@Model.Current?.ProductId" type="hidden" /> }</div>
        <div><label asp-for="Input.DiscountPercent" class="block text-sm">Desconto (%)</label><input asp-for="Input.DiscountPercent" type="number" min="0.01" max="99.99" step="0.01" class="mt-1 w-full rounded border px-3 py-2" required /></div>
        <div><label asp-for="Input.StartDate" class="block text-sm">Início</label><input asp-for="Input.StartDate" type="date" class="mt-1 w-full rounded border px-3 py-2" required /></div>
        <div><label asp-for="Input.EndDate" class="block text-sm">Fim</label><input asp-for="Input.EndDate" type="date" class="mt-1 w-full rounded border px-3 py-2" required /></div>
        <div class="sm:col-span-2 lg:col-span-4"><button class="rounded bg-slate-900 px-4 py-2 text-white">Salvar promoção</button></div>
    </form>
</section>
